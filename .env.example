# Local configuration template. Generate an ignored .env with npm run env:init.
# These placeholders are not credentials and must not be used as real values.
APP_ENV=local
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:3000
# Host-run default; Compose overrides the bind address inside its container.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1

# PostgreSQL, shared by Docker Compose and Prisma. Local host-run backend.
POSTGRES_USER=cloudvault_user
POSTGRES_PASSWORD=change-me-generated-postgres-password
POSTGRES_DB=cloudvault_dev
DATABASE_URL=postgresql://cloudvault_user:change-me-generated-postgres-password@127.0.0.1:5432/cloudvault_dev?schema=public

# Login JWT cookie; registration does not issue tokens. TTL: 1s to 24h (integer s/m/h/d).
JWT_SECRET=change-me-generated-jwt-secret
JWT_EXPIRES_IN=1h
DEFAULT_USER_STORAGE_LIMIT_BYTES=1073741824

# MinIO administrator credentials stay inside Docker Compose initialization.
MINIO_ROOT_USER=change-me-generated-minio-root-user
MINIO_ROOT_PASSWORD=change-me-generated-minio-root-password

# Separate application identity with bucket-scoped policy, never sent to the SPA.
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-reachable signing endpoint; Compose keeps this separate from minio:9000.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cloud-storage-local
S3_ACCESS_KEY_ID=change-me-generated-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-generated-s3-secret-key
S3_FORCE_PATH_STYLE=true

# Baseline policy; resumable sessions require a separate transfer ADR later.
MAX_UPLOAD_BYTES=104857600
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm
PRESIGNED_URL_TTL_SECONDS=300
